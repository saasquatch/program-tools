{
  "name": "@saasquatch/component-environment",
  "version": "2.0.1-0",
  "description": "Environment and contexts for SaaSquatch components",
  "license": "MIT",
  "author": "ReferralSaaSquatch.com, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/saasquatch/program-tools",
    "directory": "packages/component-environment"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit && oxlint",
    "format": "oxfmt",
    "prepack": "npm run build",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then echo 'Error: Publish through the Changesets release PR or the prerelease GitHub Actions workflow.'; exit 1; fi",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts --allow-git=none",
    "release": "changeset publish --no-git-tag",
    "test": "node --import ./__tests__/setup/dom.ts --test '__tests__/**/*.spec.ts'"
  },
  "dependencies": {
    "@wry/equality": "^0.5.7",
    "dom-context": "^1.3.1",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0 || ^26"
    }
  }
}
