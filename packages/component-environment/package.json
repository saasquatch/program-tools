{
  "name": "@saasquatch/component-environment",
  "version": "1.0.11",
  "description": "Environment and contexts for SaaSquatch components",
  "license": "MIT",
  "author": "ReferralSaaSquatch.com, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/saasquatch/program-tools",
    "directory": "packages/component-environment"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit && oxlint",
    "format": "oxfmt",
    "prepack": "npm run build",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then echo Error: Publishing manually is not supported. Please use the GitHub action. && exit 1; fi",
    "test": "node --import ./__tests__/setup/dom.ts --test '__tests__/**/*.spec.ts'"
  },
  "dependencies": {
    "@wry/equality": "^0.5.7",
    "dom-context": "^1.3.1",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^24 || ^26"
  }
}
