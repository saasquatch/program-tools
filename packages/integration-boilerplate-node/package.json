      "minimatch": "^11.0.1",
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/express-sslify": "^1.2.5",
    "@types/json-schema": "^7.0.15",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/node-fetch": "^2.6.13",
    "@vitest/coverage-v8": "^5.1.0",
    "jest-cucumber": "^4.5.0",
    "msw": "^2.15.0",
