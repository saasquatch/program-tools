{
  "name": "@saasquatch/component-boilerplate",
  "version": "1.6.13",
  "private": false,
  "description": "Boilerplate for writing web components for the SaaSquatch widget environments",
  "source": [
    "src/index.ts",
    "src/canned.ts"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./canned": {
      "types": "./dist/canned.d.mts",
      "import": "./dist/canned.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "canned"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saasquatch/program-tools.git",
    "directory": "packages/component-boilerplate"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "test": "vitest run",
    "test-watch": "vitest",
    "prepack": "npm run build",
    "sync-canned-schema": "node scripts/sync-canned-schema.js",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts --allow-git=none",
    "release": "changeset publish --no-git-tag",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then echo 'Error: Publish through the Changesets release PR or the prerelease GitHub Actions workflow.'; exit 1; fi"
  },
  "author": "ReferralSaaSquatch.com, Inc.",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@testing-library/react-hooks": "^5.1.3",
    "@types/debounce": "^1.2.4",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.2",
    "graphql-tag": "^2.12.7",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "react": "^17.0.1",
    "react-test-renderer": "^17.0.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@graphql-tools/mock": "^7.0.0",
    "@graphql-tools/schema": "^7.1.5",
    "@saasquatch/component-environment": "^2.0.0",
    "@saasquatch/dom-context-hooks": "^1.0.5",
    "@saasquatch/stencil-hooks": "^2.0.4",
    "@saasquatch/universal-hooks": "^1.0.1",
    "@wry/equality": "^0.5.7",
    "debounce": "^1.2.1",
    "dom-context": "^1.3.1",
    "fast-equals": "^5.4.5",
    "fast-memoize": "^2.5.2",
    "graphql": "^15.10.3",
    "graphql-combine-query": "^1.2.4",
    "graphql-request": "^3.7.0",
    "jsonpointer": "^5.0.1",
    "jwt-decode": "^4.0.0",
    "nanoid": "^3.3.20",
    "rxjs": "^6.6.7"
  },
  "overrides": {
    "msw": {
      "graphql": "$graphql"
    }
  }
}
