{
  "name": "@saasquatch/logger",
  "version": "3.0.1-1",
  "private": false,
  "description": "Small structured JSON logger for SaaSquatch NodeJS services",
  "homepage": "https://github.com/saasquatch/program-tools/packages/logger#readme",
  "bugs": {
    "url": "https://github.com/saasquatch/program-tools/issues"
  },
  "license": "MIT",
  "author": "ReferralSaaSquatch.com, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saasquatch/program-tools.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout test/*.test.ts",
    "build": "tsc -b",
    "check": "tsc --noEmit && oxlint",
    "format": "oxfmt",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then echo Error: Publishing manually is not supported. Please use the GitHub action. && exit 1; fi",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.12.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "express": "^4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24 || ^26"
  }
}
