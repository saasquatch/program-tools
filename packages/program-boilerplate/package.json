{
  "name": "@saasquatch/program-boilerplate",
  "version": "4.2.2-1",
  "description": "Boilerplate for writing programs",
  "license": "MIT",
  "author": "ReferralSaaSquatch.com, Inc.",
  "repository": {
    "url": "https://github.com/saasquatch/program-tools"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc --noEmit && oxlint",
    "format": "oxfmt",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then echo Error: Publishing manually is not supported. Please use the GitHub action. && exit 1; fi",
    "prepack": "npm run build",
    "test": "SSQT_LOG_LEVEL=emerg node --test __tests__/**/*.ts"
  },
  "dependencies": {
    "@saasquatch/jsonata-paths-extractor": "^1.0.2",
    "@saasquatch/logger": "^3.0.1-8",
    "@saasquatch/schema": "^2.2.0",
    "bson-objectid": "^2.0.4",
    "compression": "^1.8.1",
    "express": "^4.22.2",
    "jsonata": "^1.8.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.12.4",
    "@types/supertest": "^7.2.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^24 || ^26"
  }
}
