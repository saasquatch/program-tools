{
  "name": "@saasquatch/express-boilerplate",
  "version": "1.1.2-2",
  "description": "Boilerplate middleware and functions for building Express apps on Kubernetes",
  "main": "dist/index.js",
  "type": "module",
  "private": false,
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "author": "ReferralSaaSquatch.com, Inc.",
  "license": "MIT",
  "engines": {
    "node": "^24 || ^26"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saasquatch/program-tools.git"
  },
  "bugs": {
    "url": "https://github.com/saasquatch/program-tools/issues"
  },
  "homepage": "https://github.com/saasquatch/program-tools/packages/express-boilerplate#readme",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout src/tests/**/*.ts",
    "build": "tsc -b",
    "check": "tsc --noEmit && npm run lint",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then echo Error: Publishing manually is not supported. Please use the GitHub action. && exit 1; fi",
    "prepack": "npm run build",
    "lint": "eslint ./src --report-unused-disable-directives"
  },
  "dependencies": {
    "nanoid": "^3.3.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@saasquatch/logger": "^3.0.0",
    "@types/express": "4",
    "@types/node": "^24.12.4",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "express": "4",
    "winston": "3"
  },
  "prettier": {}
}
