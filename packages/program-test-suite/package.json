{
  "name": "@saasquatch/program-test-suite",
  "version": "2.8.1",
  "description": "A collection of utilities for creating program unit tests",
  "license": "MIT",
  "author": "ReferralSaaSquatch.com, Inc.",
  "repository": {
    "url": "https://github.com/saasquatch/program-tools"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc --noEmit && oxlint",
    "format": "oxfmt",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then echo Error: Publishing manually is not supported. Please use the GitHub action. && exit 1; fi",
    "prepack": "npm run build",
    "test": "SSQT_LOG_LEVEL=emerg node --test __tests__/**/*.ts"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "^20.1.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@faker-js/faker": "^10.6.0",
    "@saasquatch/program-boilerplate": "^4.2.2-1",
    "@saasquatch/schema": "^2.2.0",
    "deepmerge": "^4.3.1",
    "dlv": "^1.1.3"
  },
  "devDependencies": {
    "@types/dlv": "^1.1.5",
    "@types/node": "^24.13.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^24 || ^26"
  }
}
