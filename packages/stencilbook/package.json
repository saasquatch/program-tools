{
  "name": "@saasquatch/stencilbook",
  "version": "1.1.1",
  "description": "Storybook, but built with Stencil. Used to provide an easy to view and test implemented components and all of their states / specs, and to easily share progress with customers.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts --allow-git=none",
    "release": "changeset publish --no-git-tag",
    "prepublishOnly": "if [ \"$CI\" != \"true\" ]; then echo 'Error: Publish through the Changesets release PR or the prerelease GitHub Actions workflow.'; exit 1; fi"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@emotion/css": "^11.1.3",
    "@saasquatch/universal-hooks": "^1.0.0",
    "@stencil/core": "^2.4.0",
    "lodash.startcase": "^4.4.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saasquatch/program-tools.git",
    "directory": "packages/stencilbook"
  },
  "author": "ReferralSaaSquatch.com, Inc.",
  "bugs": {
    "url": "https://github.com/saasquatch/program-tools"
  },
  "homepage": "https://github.com/saasquatch/program-tools",
  "license": "MIT"
}
