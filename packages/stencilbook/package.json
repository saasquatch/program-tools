{
  "name": "@saasquatch/stencilbook",
  "version": "1.2.0",
  "description": "Storybook, but built with Stencil. Used to provide an easy to view and test implemented components and all of their states / specs, and to easily share progress with customers.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@emotion/css": "^11.1.3",
    "@saasquatch/universal-hooks": "^1.0.0",
    "@stencil/core": "^2.4.0",
    "lodash.startcase": "^4.4.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saasquatch/program-tools.git",
    "directory": "packages/stencilbook"
  },
  "author": "ReferralSaaSquatch.com, Inc.",
  "bugs": {
    "url": "https://github.com/saasquatch/program-tools"
  },
  "homepage": "https://github.com/saasquatch/program-tools",
  "license": "MIT"
}
